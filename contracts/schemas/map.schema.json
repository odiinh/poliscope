{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://poliscope.invalid/contracts/map.schema.json",
  "$ref": "#/definitions/MapData",
  "definitions": {
    "MapData": {
      "type": "object",
      "properties": {
        "mean": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 10,
          "maxItems": 10
        },
        "components": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 10,
            "maxItems": 10
          },
          "minItems": 2,
          "maxItems": 2
        },
        "explained": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]{2}-[0-9]{4}$"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mean",
        "components",
        "explained",
        "points"
      ],
      "additionalProperties": false
    }
  }
}
