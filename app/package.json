{
  "name": "poliscope-app",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "gen:types": "json2ts -i ../contracts/schemas/contracts.schema.json -o src/types/contracts.ts --cwd ../contracts/schemas",
    "dev": "make -C .. sync && next dev",
    "build": "make -C .. sync && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3",
    "shadcn": "^4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "clsx": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "json-schema-to-typescript": "^15",
    "typescript": "^5.9",
    "vitest": "^4"
  }
}
