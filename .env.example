# Required only when downloading fresh FRED observations with make data.
FRED_API_KEY=

# Local extraction uses an installed, authenticated Claude CLI.
LLM_PROVIDER=claude-cli
LLM_MODEL_BATCH=haiku
LLM_MODEL_LIVE=sonnet
LLM_CONCURRENCY=8

# Reserved for the hosted HTTP provider adapter tracked in issue #1.
LLM_API_KEY=

# Docker sets this false during its build and runtime.
POLISCOPE_LIVE_EXTRACTION_ENABLED=true
